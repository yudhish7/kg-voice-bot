# Copy to .env and export (e.g. `set -a; source .env; set +a`). All optional.
ANTHROPIC_API_KEY=
KGV_DATA_DIR=.kgvoicebot
KGV_EXTRACTOR=auto      # auto | rules | llm
KGV_GENERATOR=auto      # auto | llm | extractive
KGV_ASR=auto            # auto | whisper | text
KGV_TTS=auto            # auto | espeak | stub
KGV_LLM_MODEL=claude-sonnet-5-5
KGV_WHISPER_MODEL=base
KGV_HOPS=2
KGV_TOP_K=4
KGV_MAX_FACTS=15
KGV_MAX_AUDIO_BYTES=10485760
KGV_API_KEY=
